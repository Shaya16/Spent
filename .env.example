# Spent - Personal Finance Tracker
# Copy this file to .env and fill in your values.
# This file is committed to git as a template. Never commit .env itself.

# Optional: Override the default host/port for the dev server
# HOST=127.0.0.1
# PORT=3000

# Telegram bot (optional). Get a token from @BotFather and your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CARD_BILLING_DAY=10

# Keep Next.js from sending anonymous build telemetry.
NEXT_TELEMETRY_DISABLED=1

# Use @sergienko4/israeli-bank-scrapers for Isracard and Max (browserless). Off by default:
# on an install that already has Isracard/Max history, rows from the two libraries may not
# deduplicate against each other.
# SPENT_SCRAPER_FORK=1

# Extra host names allowed to reach the app (comma-separated), e.g. a home server name or LAN IP.
# Only localhost is accepted by default, which blocks DNS-rebinding attacks from websites.
# The app listens on 127.0.0.1 only, so this matters behind a reverse proxy or when started with another -H.
# SPENT_ALLOWED_HOSTS=homeserver,192.168.1.20

# Allow an Ollama server on another machine. Off by default so the setting cannot be pointed
# at a foreign server to collect transaction descriptions.
# SPENT_ALLOW_REMOTE_OLLAMA=1

# Update check (Docker sets SPENT_UPDATE_CHECK=1): a Telegram message when the tracked branch has a newer commit.
# Only public commit metadata is read from GitHub; nothing is installed automatically.
# SPENT_UPDATE_CHECK=1
# SPENT_UPDATE_REPO=Shaya16/Spent
# SPENT_UPDATE_BRANCH=main
