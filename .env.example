# Spent - Personal Finance Tracker
# Copy this file to .env and fill in your values.
# This file is committed to git as a template. Never commit .env itself.

# Optional: Override the default host/port for the dev server
# HOST=127.0.0.1
# PORT=3000

# Telegram bot (optional). Get a token from @BotFather and your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CARD_BILLING_DAY=10

# Keep Next.js from sending anonymous build telemetry.
NEXT_TELEMETRY_DISABLED=1
