{
  "name": "spent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 41234",
    "lint": "eslint",
    "security:audit": "npm audit --omit=dev",
    "security:outdated": "npm outdated",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "setup": "node scripts/setup.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "service:install": "node scripts/service/install.mjs install",
    "service:uninstall": "node scripts/service/install.mjs uninstall",
    "service:start": "node scripts/service/install.mjs start",
    "service:stop": "node scripts/service/install.mjs stop",
    "service:reload": "npm run build && node scripts/service/install.mjs stop && node scripts/service/install.mjs start",
    "service:status": "node scripts/service/install.mjs status",
    "service:logs": "node scripts/service/install.mjs logs",
    "service:open": "node scripts/service/install.mjs open",
    "menubar:build": "bash menubar/mac/build.sh",
    "menubar:install:mac": "bash menubar/mac/build.sh && cp -R menubar/mac/build/Spent.app ~/Applications/",
    "menubar:build:windows": "powershell -ExecutionPolicy Bypass -File menubar/windows/build.ps1",
    "menubar:install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './menubar/windows/build.ps1'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $d = Join-Path $env:LOCALAPPDATA 'Programs\\Spent'; New-Item -ItemType Directory -Force -Path $d | Out-Null; Copy-Item -Force 'menubar/windows/build/Spent.exe' (Join-Path $d 'Spent.exe')\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@base-ui/react": "^1.9.0",
    "@sergienko4/israeli-bank-scrapers": "9.0.0",
    "@tanstack/react-query": "^5.105.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "grammy": "1.46.0",
    "israeli-bank-scrapers": "6.13.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@hieutran094/camoufox-js": "0.11.2",
    "playwright-core": "1.64.1"
  }
}
